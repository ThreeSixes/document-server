services:
  {{ kiwixService }}:
    image: "{{ kiwixImage }}:{{ kiwixTag }}"
    container_name: {{ kiwixService }}
    restart: unless-stopped
    environment:
      - THREADS=2
    command: "-r /{{ kiwixPath }}/ *.zim"
    volumes:
      - ./nginx-root/{{ contentPath }}/wikis-active:/data:ro
    develop:
      watch:
        - action: sync+restart
          path: ./nginx-root/{{ contentPath }}/wikis-active
          target: /data
    expose:
      - "{{ kiwixPort }}"
  {{ nginxService }}:
    image: "{{ nginxImage }}:{{ nginxTag }}"
    container_name: nginx
    restart: unless-stopped
    volumes:
      - ./config/nginx-default.conf:/etc/nginx/conf.d/default.conf
      - type: bind
        source: ./nginx-root
        target: /usr/share/nginx/html
        read_only: true
    develop:
      watch:
        - action: sync+restart
          path: ./config/nginx-default.conf
          target: /etc/nginx/conf.d/default.conf
    ports:
      - "{{ listenHost }}:{{ externalWebPort }}:{{ nginxPort }}"
    sysctls:
      - net.ipv4.ip_unprivileged_port_start=0
