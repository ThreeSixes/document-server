[Unit]
Description=Run AP mode handler after delay
After=network-online.target
Requires=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/{{ hostvars[inventory_hostname].user }}/ap-mode-handler/
ExecStart=/home/{{ hostvars[inventory_hostname].user }}/ap-mode-handler/ap-mode-handler.sh auto-delay
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
